# ==============================================================================
# Steadfast Environment Configuration Template (.env.example)
#
# NOTE: This file contains FAKE demo values only. Never put real secrets here.
# To configure your local environment, copy this file to .env:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# Environment profile: 'demo' enables chaos and mutation switches; 'prod' strictly refuses them
STEADFAST_ENV=demo

# PostgreSQL container credentials and local port binding (bound to 127.0.0.1)
POSTGRES_DB=steadfast
POSTGRES_USER=steadfast_user
POSTGRES_PASSWORD=fake_pg_password_for_local_demo_only
POSTGRES_PORT=5432

# Database connection strings (Postgres is the sole datastore for Steadfast)
DATABASE_URL=postgres://steadfast_user:fake_pg_password_for_local_demo_only@127.0.0.1:5432/steadfast?sslmode=disable
CHECKER_DATABASE_URL=postgres://steadfast_ro:fake_ro_password_for_local_demo@127.0.0.1:5432/steadfast?sslmode=disable

# Baseline and mock services (Redis is used ONLY by the baseline queue)
REDIS_URL=redis://127.0.0.1:6379/0
LEDGER_URL=http://127.0.0.1:8081

# Authentication keys (fake values for demo; seed script provisions real random keys in .env)
ADMIN_KEY=fake_admin_key_for_local_demo_only_32_bytes_min
DEMO_TENANT_A_KEY=fake_tenant_a_key_for_local_demo_only_shop_a
DEMO_TENANT_B_KEY=fake_tenant_b_key_for_local_demo_only_shop_b

# Queue leases and timings (demo profile: shorter intervals for fast visible recovery)
LEASE_SECONDS=10
HEARTBEAT_SECONDS=3
REAPER_INTERVAL_MS=1000
BACKOFF_BASE_MS=500
BACKOFF_CAP_MS=15000
DEFAULT_MAX_ATTEMPTS=5

# Engine caps and TTLs
IDEMPOTENCY_TTL_HOURS=24
MAX_PAYLOAD_BYTES=65536
RATE_LIMIT_RPS=5000

# Circuit breaker parameters (P1)
BREAKER_MIN_SAMPLES=10
BREAKER_FAILURE_RATIO=0.5
BREAKER_COOLDOWN_SECONDS=10

# Baseline configuration (fair comparison settings)
BASELINE_PATTERN=visibility_timeout
BASELINE_VISIBILITY_SECONDS=10
BASELINE_SEND_IDEMPOTENCY_KEY=false
